		{
			"name": "FEE-L01 A year's fee structure is created as one row per term",
			"description": "Proves: REQ-050.AC7",
			"item": [
				{
					"name": "FEE-L01 01 POST /api/fee-structures",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/fee-structures",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fee-structures"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"courseId\": \"Violin\",\n  \"year\": 2025,\n  \"numberOfTerms\": 4,\n  \"termFees\": [\n    {\n      \"term\": 1,\n      \"amount\": 1000\n    },\n    {\n      \"term\": 2,\n      \"amount\": 1000\n    },\n    {\n      \"term\": 3,\n      \"amount\": 1200\n    },\n    {\n      \"term\": 4,\n      \"amount\": 1200\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status\", () => {",
									"  pm.response.to.have.status(200);",
									"});",
									"pm.test(\"body\", () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b, \" length\").to.have.lengthOf(4);",
									"  pm.expect((b || []).some(y => ((y !== null && typeof y === 'object' && !Array.isArray(y)) && ((y?.course !== null && typeof y?.course === 'object' && !Array.isArray(y?.course)) && (y?.course?.name === \"Violin\")) && (y?.year === 2025) && (y?.term === 1) && (y?.amount === 1000) && (y?.isActive === true) && ((Number.isInteger(y?.id))))), \" includes {\\\"course\\\": {\\\"name\\\": \\\"Violin\\\"}, \\\"year\\\": 2025, \\\"term\\\": 1, \\\"amount\\\": 1000, \\\"isActive\\\": true, \\\"id\\\": {\\\"$type\\\": \\\"integer\\\"}}\").to.be.true;",
									"  pm.expect((b || []).some(y => ((y !== null && typeof y === 'object' && !Array.isArray(y)) && ((y?.course !== null && typeof y?.course === 'object' && !Array.isArray(y?.course)) && (y?.course?.name === \"Violin\")) && (y?.year === 2025) && (y?.term === 2) && (y?.amount === 1000) && (y?.isActive === true))), \" includes {\\\"course\\\": {\\\"name\\\": \\\"Violin\\\"}, \\\"year\\\": 2025, \\\"term\\\": 2, \\\"amount\\\": 1000, \\\"isActive\\\": true}\").to.be.true;",
									"  pm.expect((b || []).some(y => ((y !== null && typeof y === 'object' && !Array.isArray(y)) && ((y?.course !== null && typeof y?.course === 'object' && !Array.isArray(y?.course)) && (y?.course?.name === \"Violin\")) && (y?.year === 2025) && (y?.term === 3) && (y?.amount === 1200) && (y?.isActive === true))), \" includes {\\\"course\\\": {\\\"name\\\": \\\"Violin\\\"}, \\\"year\\\": 2025, \\\"term\\\": 3, \\\"amount\\\": 1200, \\\"isActive\\\": true}\").to.be.true;",
									"  pm.expect((b || []).some(y => ((y !== null && typeof y === 'object' && !Array.isArray(y)) && ((y?.course !== null && typeof y?.course === 'object' && !Array.isArray(y?.course)) && (y?.course?.name === \"Violin\")) && (y?.year === 2025) && (y?.term === 4) && (y?.amount === 1200) && (y?.isActive === true))), \" includes {\\\"course\\\": {\\\"name\\\": \\\"Violin\\\"}, \\\"year\\\": 2025, \\\"term\\\": 4, \\\"amount\\\": 1200, \\\"isActive\\\": true}\").to.be.true;",
									"});"
								]
							}
						}
					]
				}
			]
		},
