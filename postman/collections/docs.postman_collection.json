{
	"info": {
		"name": "Sonata API - Docs",
		"description": "Generated API docs (REQ-009).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "00 Setup",
			"description": "Logs in as the bootstrap administrator. run.js runs this before every case.",
			"item": [
				{
					"name": "Setup 01 POST /api/auth/login (bootstrap admin)",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('admin can log in', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"// 'root' and 'admin' are the same bootstrap administrator.",
									"pm.collectionVariables.set('admin', b.accessToken);",
									"pm.collectionVariables.set('adminRefresh', b.refreshToken);",
									"pm.collectionVariables.set('root', b.accessToken);",
									"pm.collectionVariables.set('rootRefresh', b.refreshToken);"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "DOC-001 The OpenAPI spec and the browsable docs are served without a token",
			"description": "Proves: REQ-009.AC1",
			"item": [
				{
					"name": "DOC-001 01 GET /v3/api-docs",
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v3/api-docs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"api-docs"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status', () => pm.response.to.have.status(200));",
									"pm.test('an OpenAPI 3 spec of the API', () => {",
									"  const spec = pm.response.json();",
									"  pm.expect(spec.openapi).to.match(/^3\\./);",
									"  pm.expect(spec.paths).to.include.keys('/api/students', '/api/payments', '/api/roles', '/api/auth/login');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "DOC-001 02 GET /swagger-ui/index.html",
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/swagger-ui/index.html",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"swagger-ui",
								"index.html"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status', () => pm.response.to.have.status(200));",
									"pm.test('html', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "DOC-002 The spec declares the bearer token, the request and session id headers, and the error body",
			"description": "Proves: REQ-009.AC2",
			"item": [
				{
					"name": "DOC-002 01 GET /v3/api-docs",
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v3/api-docs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"api-docs"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const spec = pm.response.json();",
									"pm.test('bearer token scheme, required by default', () => {",
									"  pm.expect(spec.components.securitySchemes.bearerAuth).to.include({ type: 'http', scheme: 'bearer' });",
									"  pm.expect(spec.security).to.deep.include({ bearerAuth: [] });",
									"});",
									"pm.test('login is marked as needing no token', () => pm.expect(spec.paths['/api/auth/login'].post.security).to.eql([]));",
									"pm.test('X-Request-Id and X-Session-Id are request headers', () => {",
									"  const names = (spec.paths['/api/students'].get.parameters || []).filter(p => p.in === 'header').map(p => p.name);",
									"  pm.expect(names).to.include.members(['X-Request-Id', 'X-Session-Id']);",
									"});",
									"pm.test('standard error body', () => {",
									"  pm.expect(spec.components.schemas.ApiError.properties).to.include.keys('status', 'error', 'message', 'details', 'timestamp');",
									"  pm.expect(spec.paths['/api/students'].get.responses['403'].content['application/json'].schema.$ref).to.eql('#/components/schemas/ApiError');",
									"});"
								]
							}
						}
					]
				}
			]
		}
	]
}
