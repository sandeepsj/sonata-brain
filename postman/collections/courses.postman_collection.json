							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/courses",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"courses"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Keyboard\"\n}",
							"options": {
