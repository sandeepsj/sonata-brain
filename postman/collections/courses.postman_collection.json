{
	"info": {
		"name": "Sonata API - Courses",
		"description": "Run with postman/run.js (fresh database, clean slate per case) or in the Postman app. See postman/README.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Date helpers for the tests: {{today}}, {{today_m40d}} (40 days ago), {{today_p1d}}, {{year}}, {{year_m1}}, ...",
					"const pad = (n) => String(n).padStart(2, '0');",
					"const day = (offset) => { const d = new Date(); d.setDate(d.getDate() + offset); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };",
					"pm.collectionVariables.set('today', day(0));",
					"for (const n of [-100, -60, -50, -40, -30, -20, -10, -6, -5, 1]) pm.collectionVariables.set(`today_${n > 0 ? 'p' : 'm'}${Math.abs(n)}d`, day(n));",
					"const year = new Date().getFullYear();",
					"pm.collectionVariables.set('year', year);",
					"for (const n of [-1, 1]) pm.collectionVariables.set(`year_${n > 0 ? 'p' : 'm'}${Math.abs(n)}`, year + n);"
				]
			}
		}
	],
	"item": [
		{
			"name": "00 Setup",
			"description": "Logs in as the bootstrap administrator. run.js runs this before every case.",
			"item": [
				{
					"name": "Setup 01 POST /api/auth/login (bootstrap admin)",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('admin can log in', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"// 'root' and 'admin' are the same bootstrap administrator.",
									"pm.collectionVariables.set('admin', b.accessToken);",
									"pm.collectionVariables.set('adminRefresh', b.refreshToken);",
									"pm.collectionVariables.set('root', b.accessToken);",
									"pm.collectionVariables.set('rootRefresh', b.refreshToken);"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "CRS-001 A course is created from its name; its id is the name",
			"description": "Proves: REQ-040.AC1",
			"item": [
				{
					"name": "CRS-001 01 POST /api/courses",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/courses",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"courses"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Violin\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status\", () => {",
									"  pm.response.to.have.status(200);",
									"});",
									"pm.test(\"body\", () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b?.name, \"name\").to.eql(\"Violin\");",
									"  pm.expect(b?.id, \"id\").to.eql(\"Violin\");",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
