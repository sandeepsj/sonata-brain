				{
					"name": "CRS-002 03 GET /api/courses",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/courses",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"courses"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status\", () => {",
									"  pm.response.to.have.status(200);",
									"});",
									"pm.test(\"body\", () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b, \" length\").to.have.lengthOf(2);",
									"  pm.expect((b || []).some(y => ((y !== null && typeof y === 'object' && !Array.isArray(y)) && (y?.name === \"Violin\"))), \" includes {\\\"name\\\": \\\"Violin\\\"}\").to.be.true;",
									"  pm.expect((b || []).some(y => ((y !== null && typeof y === 'object' && !Array.isArray(y)) && (y?.name === \"Keyboard\"))), \" includes {\\\"name\\\": \\\"Keyboard\\\"}\").to.be.true;",
									"});"
								]
							}
						}
					]
				}
			]
		}
	]
}
