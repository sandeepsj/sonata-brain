{
	"info": {
		"name": "Sonata API - Platform",
		"description": "Run with postman/run.js (fresh database, clean slate per case) or in the Postman app. See postman/README.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Date helpers for the tests: {{today}}, {{today_m40d}} (40 days ago), {{today_p1d}}, {{year}}, {{year_m1}}, ...",
					"const pad = (n) => String(n).padStart(2, '0');",
					"const day = (offset) => { const d = new Date(); d.setDate(d.getDate() + offset); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };",
					"pm.collectionVariables.set('today', day(0));",
					"for (const n of [-100, -60, -50, -40, -30, -20, -10, -6, -5, 1]) pm.collectionVariables.set(`today_${n > 0 ? 'p' : 'm'}${Math.abs(n)}d`, day(n));",
					"const year = new Date().getFullYear();",
					"pm.collectionVariables.set('year', year);",
					"for (const n of [-1, 1]) pm.collectionVariables.set(`year_${n > 0 ? 'p' : 'm'}${Math.abs(n)}`, year + n);"
				]
			}
		}
	],
	"item": [
		{
			"name": "00 Setup",
			"description": "Logs in as the bootstrap administrator. run.js runs this before every case.",
			"item": [
				{
					"name": "Setup 01 POST /api/auth/login (bootstrap admin)",
					"request": {
						"method": "POST",
						"auth": {
							"type": "noauth"
						},
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('admin can log in', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"// 'root' and 'admin' are the same bootstrap administrator.",
									"pm.collectionVariables.set('admin', b.accessToken);",
									"pm.collectionVariables.set('adminRefresh', b.refreshToken);",
									"pm.collectionVariables.set('root', b.accessToken);",
									"pm.collectionVariables.set('rootRefresh', b.refreshToken);"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "PLT-T03 A malformed request body gives 400 without internal details",
			"description": "Proves: REQ-005.AC3",
			"item": [
				{
					"name": "PLT-T03 01 POST /api/students",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/students",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"students"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\"studentName\": \"Asha\", "
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status\", () => {",
									"  pm.response.to.have.status(400);",
									"});",
									"pm.test(\"body\", () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b, 'standard error body').to.include.all.keys('status', 'error', 'message', 'details', 'timestamp');",
									"  pm.expect(b.status, 'error status').to.be.a('number');",
									"  pm.expect(b.message, 'error message').to.be.a('string').and.match(/\\S/);",
									"  pm.expect(b.details, 'error details').to.be.an('array');",
									"  pm.expect(b, 'error body').to.not.have.any.keys('trace', 'exception');",
									"  pm.expect((!((typeof b?.message === 'string' && b?.message.toLowerCase().includes(String(\"jackson\").toLowerCase())))), \"message matches {\\\"$not\\\": {\\\"$contains\\\": \\\"jackson\\\"}}\").to.be.true;",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "PLT-T04 An unexpected server error never leaks a stack trace or SQL",
			"description": "Proves: REQ-005.AC3",
			"item": [
				{
					"name": "PLT-T04 01 GET /api/students/not-a-number",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/students/not-a-number",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"students",
								"not-a-number"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status\", () => {",
									"  pm.response.to.have.status(400);",
									"});",
									"pm.test(\"body\", () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b, 'standard error body').to.include.all.keys('status', 'error', 'message', 'details', 'timestamp');",
									"  pm.expect(b.status, 'error status').to.be.a('number');",
									"  pm.expect(b.message, 'error message').to.be.a('string').and.match(/\\S/);",
									"  pm.expect(b.details, 'error details').to.be.an('array');",
									"  pm.expect(b, 'error body').to.not.have.any.keys('trace', 'exception');",
									"  pm.expect((!((typeof b?.message === 'string' && new RegExp(\"exception|java\\\\.|select |numberformat\", \"i\").test(b?.message)))), \"message matches {\\\"$not\\\": {\\\"$regex\\\": \\\"(?i)exception|java\\\\\\\\.|select |numberformat\\\"}}\").to.be.true;",
									"});"
								]
							}
						}
					]
				}
			]
		}
	]
}
